# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / auth
AUTH_SECRET=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cache / rate limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=

# Email (Resend adapter)
EMAIL_FROM=
RESEND_API_KEY=

# ArCa card payments (optional until provisioned)
ARCA_TEST_MODE=true
ARCA_BANK=idbank
ARCA_USERNAME=
ARCA_PASSWORD=
ARCA_LIVE_USERNAME=
ARCA_LIVE_PASSWORD=

# FastShift wallet payments (optional until provisioned)
FASTSHIFT_TEST_MODE=true
FASTSHIFT_TOKEN=
FASTSHIFT_LIVE_TOKEN=
# Optional overrides (defaults point at merchants.fastshift.am)
# FASTSHIFT_REGISTER_URL=
# FASTSHIFT_STATUS_URL_BASE=

# Dev/test seed only (never commit real passwords)
